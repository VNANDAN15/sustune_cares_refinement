# Sustune Care — Environment Configuration Example
# Copy this file to .env.local for local development.
# Do NOT commit sensitive keys to source control.

# Canonical Domain URL
NEXT_PUBLIC_APP_URL=https://www.sustunecare.com

# Content Claims Approval Gating
# Set to 'true' only to preview pending-approval claims in staging/internal review.
NEXT_PUBLIC_SHOW_PENDING_APPROVAL=false

# Swappable Lead Intake Layer Configuration
# Options: 'none' (default, honest local logging), 'webhook', 'email'
LEAD_INTAKE_ADAPTER=none

# Webhook Adapter Destination (Required if LEAD_INTAKE_ADAPTER=webhook)
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Email Adapter Configuration (Required if LEAD_INTAKE_ADAPTER=email)
# LEAD_RECIPIENT_EMAIL=contact@sustunecare.com
# RESEND_API_KEY=re_sample_key_here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=postmaster@sustunecare.com
# SMTP_PASS=secret

# Video CDN Base URL (Optional — defaults to /videos/ if empty)
NEXT_PUBLIC_VIDEO_CDN_URL=
